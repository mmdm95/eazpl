{
    "name": "mmdm/eazpl",
    "description": "A convenient way to create ZPL commands for zebra printers",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Eazpl\\": "src/",
            "Eazpl\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "MMDM",
            "email": "mmdehghan95@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-sockets": "*",
        "illuminate/database": "^12.0",
        "league/container": "^4.2",
        "league/route": "^6.0",
        "nyholm/psr7": "^1.8",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "respect/validation": "^2.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7"
    },
    "scripts": {
        "eazpl": "php bin/eazpl",
        "eazpl:migrate": "php bin/eazpl migrate",
        "eazpl:reset": "php bin/eazpl migrate:reset",
        "eazpl:status": "php bin/eazpl migrate:status",
        "eazpl:serve": "php bin/eazpl serve"
    }
}
